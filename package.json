{
  "name": "realmbreak",
  "version": "0.1.0",
  "private": true,
  "description": "REALMBREAK \u2014 an original WebXR mixed-reality fight experience. Static web app, no backend.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "budget": "node scripts/check-budget.mjs",
    "assets": "node scripts/generate-assets.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "test:xr": "node scripts/xr-smoke.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "iwer": "^2.8.0",
    "playwright": "^1.65.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}